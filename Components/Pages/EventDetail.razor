@page "/events/{Id:guid}"
@inject EventService Svc
@inject ICopilotService Copilot
@inject SessionState Session

@if (ev is null)
{
    <h1>Event not found</h1>
    <p>This event may have been deleted. <a href="/">Back to events</a></p>
}
else
{
    <PageTitle>@ev.Title</PageTitle>
    <a href="/">← All events</a>
    <h1>@ev.Title</h1>
    <p class="muted">@ev.Date.ToString("ddd, d MMM yyyy h:mm tt") · @ev.Location</p>
    @if (Session.IsRegistered(ev.Id)) { <p class="ok">✔ You're registered for this event (this session)</p> }

    <div class="stats">
        <div class="stat"><b>@ev.Registrations.Count</b>Registered</div>
        <div class="stat"><b>@ev.SpotsLeft</b>Spots left</div>
        <div class="stat"><b>@ev.Checked</b>Checked in</div>
        <div class="stat"><b>@ev.AttendanceRate.ToString("P0")</b>Attendance</div>
    </div>

    <div class="card copilot">
        <strong>✨ Copilot insights</strong>
        <ul>@foreach (var t in Copilot.Insights(ev)) { <li>@t</li> }</ul>
    </div>

    <h2>Register attendee</h2>
    <EditForm Model="form" OnValidSubmit="Register" class="card form">
        <DataAnnotationsValidator />
        <label>Name <InputText @bind-Value="form.Name" /></label>
        <ValidationMessage For="() => form.Name" />
        <label>Email <InputText type="email" @bind-Value="form.Email" /></label>
        <ValidationMessage For="() => form.Email" />
        <button type="submit" class="btn" disabled="@(ev.SpotsLeft == 0)">@(ev.SpotsLeft == 0 ? "Event full" : "Register")</button>
        @if (msg != "") { <p class="@(ok ? "ok" : "err")">@msg</p> }
    </EditForm>

    <h2>Attendance tracker</h2>
    <input class="search" placeholder="Search name or email…" @bind="search" @bind:event="oninput" />
    <table>
        <thead><tr><th>Name</th><th>Email</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Filtered)
        {
            <tr @key="r.Id">
                <td>@r.Name</td><td>@r.Email</td>
                <td>@(r.CheckedIn ? $"✅ In at {r.CheckedInAt:h:mm tt}" : "⏳ Not arrived")</td>
                <td>
                    <button class="btn small" @onclick="() => Svc.ToggleCheckIn(ev.Id, r.Id)">@(r.CheckedIn ? "Undo" : "Check in")</button>
                    <button class="btn small ghost" @onclick="() => Svc.Cancel(ev.Id, r.Id)">Remove</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    [Parameter] public Guid Id { get; set; }
    EventItem? ev;
    RegistrationForm form = new();
    string msg = "", search = "";
    bool ok;

    protected override void OnParametersSet()
    {
        ev = Svc.Get(Id);
        msg = "";
        // Prefill from the session so returning users don't retype.
        if (Session.HasProfile && form.Name == "" && form.Email == "")
            form = new RegistrationForm { Name = Session.Name, Email = Session.Email };
    }

    IEnumerable<Registration> Filtered => ev!.Registrations.Where(r =>
        r.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        r.Email.Contains(search, StringComparison.OrdinalIgnoreCase));

    void Register()
    {
        (ok, msg) = Svc.Register(Id, form.Name, form.Email);
        if (ok) { Session.Remember(form.Name.Trim(), form.Email.Trim(), Id); form = new RegistrationForm { Name = Session.Name, Email = Session.Email }; }
    }
}
